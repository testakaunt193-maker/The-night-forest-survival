            try {
                const data = JSON.parse(saved);
                if (data.hp !== undefined) playerHP = data.hp;
                if (data.inventory) inventory = data.inventory;
                if (data.walls) {
                    data.walls.forEach(w => placeWall(w));
                }
                if (data.campfires) {
                    data.campfires.forEach(c => placeCampfire(c));
                }
                if (data.torches) {
                    data.torches.forEach(t => placeTorch(t));
                }
                console.log('Game Loaded Successfully!');
            } catch (e) {
                console.error('Error loading save data', e);
