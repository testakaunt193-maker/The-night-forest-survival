        function animate() {
            requestAnimationFrame(animate);

            if (gameIsOver) return;

            const time = performance.now();
            const delta = (time - prevTime) / 1000;
            prevTime = time;

            campfires.forEach(cf => {
                cf.light.intensity = cf.baseIntensity + Math.sin(time * 0.02) * 1.2;
                if (cf.flame) {
                    cf.flame.scale.y = 1 + Math.sin(time * 0.03) * 0.2;
                }
            });

            torches.forEach(t => {
                t.light.intensity = 4.0 + Math.sin(time * 0.03) * 0.5;
            });

            const currentSpeed = isSprinting ? 10.0 : 6.0;
            const speed = currentSpeed * delta;
            const forwardVector = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion);
            forwardVector.y = 0; forwardVector.normalize();

            const sideVector = new THREE.Vector3(1, 0, 0).applyQuaternion(camera.quaternion);
            sideVector.y = 0; sideVector.normalize();

            const moveVector = new THREE.Vector3();
            if (moveForward) moveVector.add(forwardVector);
            if (moveBackward) moveVector.sub(forwardVector);
            if (moveRight) moveVector.add(sideVector);
            if (moveLeft) moveVector.sub(sideVector);
            moveVector.normalize();

            if (moveVector.lengthSq() > 0) {
                const nextPos = camera.position.clone().addScaledVector(moveVector, speed);
                if (!checkCollisions(nextPos)) {
                    camera.position.copy(nextPos);
                }
            }

            camera.position.x = Math.max(-120, Math.min(120, camera.position.x));
            camera.position.z = Math.max(-120, Math.min(120, camera.position.z));
            camera.position.y = 1.8;

            // Cat Pet movement & visibility logic
            if (catPetGroup) {
                if (monsterSpawned) {
                    catPetGroup.visible = false; // Cat is terrified and hides when Baarnen appears!
                } else {
                    catPetGroup.visible = true;
                    const targetCatPos = camera.position.clone().add(new THREE.Vector3(1.2, 0, 1.2));
                    catPetGroup.position.lerp(targetCatPos, 0.08);
                    catPetGroup.lookAt(camera.position.x, catPetGroup.position.y, camera.position.z);
                }
            }

            if (monsterSpawned && monsterGroup) {
                let speedMultiplier = 1.0;
                for(let i = 0; i < traps.length; i++) {
                    if(monsterGroup.position.distanceTo(traps[i].position) < 1.5) {
                        speedMultiplier = 0.3;
                    }
                }

                const nextMonsterPos = monsterGroup.position.clone();
                monsterGroup.lookAt(camera.position.x, monsterGroup.position.y, camera.position.z);
                monsterGroup.translateZ(monsterSpeed * speedMultiplier * delta);

                for (let i = 0; i < placedWalls.length; i++) {
                    const w = placedWalls[i];
                    if (monsterGroup.position.distanceTo(new THREE.Vector3(w.x, 0, w.z)) < 1.4) {
                        monsterGroup.position.copy(nextMonsterPos);
                        break;
                    }
                }

                const animTime = time * 0.012;
                const leftArm = monsterGroup.getObjectByName("leftArm");
                const rightArm = monsterGroup.getObjectByName("rightArm");
                const leftLeg = monsterGroup.getObjectByName("leftLeg");
                const rightLeg = monsterGroup.getObjectByName("rightLeg");

                if (leftArm && rightArm && leftLeg && rightLeg) {
                    leftArm.rotation.x = Math.sin(animTime) * 0.7;
                    rightArm.rotation.x = -Math.sin(animTime) * 0.7;
                    leftLeg.rotation.x = -Math.sin(animTime) * 0.7;
                    rightLeg.rotation.x = Math.sin(animTime) * 0.7;
                }

                if (monsterGroup.position.distanceTo(camera.position) < 2.0) {
                    playerHP -= 25 * delta;
                    updateHPUI();
                    triggerDamageFlash();
                    if (playerHP <= 0) {
                        triggerJumpscare();
                    }
                }
            }

            updateInteractions();
            renderer.render(scene, camera);
        }

        function triggerJumpscare() {
            gameIsOver = true;
            document.getElementById('jumpscare-screen').style.display = 'flex';
        }
    </script>
</body>
</html>
