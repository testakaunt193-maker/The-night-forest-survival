        function checkCollisions(pos) {
            if (pos.x > -4.5 && pos.x < 4.5 && pos.z > -4.5 && pos.z < 4.5) return true;
            
            for (let i = 0; i < trees.length; i++) {
                const t = trees[i];
                const dx = pos.x - t.x;
                const dz = pos.z - t.z;
                if ((dx * dx + dz * dz) < (t.radius + 0.4) * (t.radius + 0.4)) return true;
            }

            for (let i = 0; i < placedWalls.length; i++) {
                const w = placedWalls[i];
                const dx = pos.x - w.x;
                const dz = pos.z - w.z;
                if ((dx * dx + dz * dz) < w.radius * w.radius) return true;
            }

            return false;
        }

        function updateInteractions() {
            nearestTree = null;
            let minTreeDist = 3.5;
            for (let i = 0; i < trees.length; i++) {
                const dist = camera.position.distanceTo(trees[i].group.position);
                if (dist < minTreeDist) {
                    minTreeDist = dist;
                    nearestTree = trees[i];
                }
            }
            const chopBtn = document.getElementById('btn-chop');
            if (nearestTree && inventory[0].count > 0) {
                chopBtn.style.display = 'block';
            } else {
                chopBtn.style.display = 'none';
            }

            nearestRabbit = null;
            let minRabbitDist = 3.0;
            for (let i = 0; i < rabbits.length; i++) {
                const dist = camera.position.distanceTo(rabbits[i].group.position);
                if (dist < minRabbitDist) {
                    minRabbitDist = dist;
                    nearestRabbit = rabbits[i];
                }
            }
            const rabbitBtn = document.getElementById('btn-kill-rabbit');
            if (nearestRabbit && inventory[0].count > 0) {
                rabbitBtn.style.display = 'block';
            } else {
                rabbitBtn.style.display = 'none';
